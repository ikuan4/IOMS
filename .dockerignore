# Never ship secrets / local env into the image
.env
.env.*
.env for mysql

# Git metadata
.git
.gitattributes
.gitignore

# Editor/OS junk
.DS_Store
Thumbs.db
.idea
.vscode

# Node / frontend
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
public/hot
public/build

# PHP vendor (installed inside image)
vendor

# Tests / QA tooling (not needed in production image)
tests
phpunit.xml
.phpunit.result.cache
phpstan.neon

# Local caches/logs (exclude contents but keep directories via .gitignore)
storage/logs

storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore

storage/framework/sessions/*
!storage/framework/sessions/.gitignore

storage/framework/testing/*
!storage/framework/testing/.gitignore

storage/framework/views/*
!storage/framework/views/.gitignore

# One-off local scripts/tools (keep out of prod image)
scripts
tools
