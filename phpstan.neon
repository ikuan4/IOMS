includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  level: 8
  paths:
    - app
  treatPhpDocTypesAsCertain: false
  bootstrapFiles:
    - vendor/autoload.php
  inferPrivatePropertyTypeFromConstructor: true
  # Exclude vendor, storage, and bootstrap cache from analysis
  excludePaths:
    - vendor/*
    - storage/*
    - bootstrap/cache/*

  # Suppress specific known false-positive categories from Larastan/PHPStan
  ignoreErrors:
    - '#uses generic trait .*HasFactory.*does not specify its types#'
    - '#Call to function method_exists.*will always evaluate to true.#'


services:
  # Larastan provides many services; keep defaults for now
